{
  "name": "@claude-plugins/pi",
  "version": "1.5.0",
  "description": "Orchestrate Pi agents from Claude Code for cost-effective task delegation",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "version": "node -e \"const fs=require('fs');const v=require('./package.json').version;const p=JSON.parse(fs.readFileSync('.claude-plugin/plugin.json'));p.version=v;fs.writeFileSync('.claude-plugin/plugin.json',JSON.stringify(p,null,2)+'\\n');\" && git add .claude-plugin/plugin.json"
  },
  "dependencies": {
    "@mariozechner/pi-coding-agent": "^0.70.6",
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.1.3",
    "@types/node": "^22.0.0"
  }
}
